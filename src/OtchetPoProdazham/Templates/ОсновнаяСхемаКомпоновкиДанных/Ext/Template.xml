		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ	ЗаказыКлиентовОбороты.Регистратор КАК РегистраторЗаказа,	NULL КАК РегистраторВыручки,	ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).Партнер КАК Партнер,	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).Дата, МЕСЯЦ) КАК ПериодМесяц,	СУММА(ЗаказыКлиентовОбороты.СуммаПриход) КАК СуммаЗаказа,	0 КАК СуммаВыручки,	ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).Валюта КАК ВалютаПОМЕСТИТЬ ВТПродажиИЗ	РегистрНакопления.ЗаказыКлиентов.Обороты(, , Регистратор, ) КАК ЗаказыКлиентовОборотыГДЕ	ЗаказыКлиентовОбороты.Регистратор ССЫЛКА Документ.ЗаказКлиентаСГРУППИРОВАТЬ ПО	ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).Партнер,	ЗаказыКлиентовОбороты.Регистратор,	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).Дата, МЕСЯЦ),	ВЫРАЗИТЬ(ЗаказыКлиентовОбороты.Регистратор КАК Документ.ЗаказКлиента).ВалютаОБЪЕДИНИТЬ ВСЕВЫБРАТЬ	NULL,	ВыручкаОбороты.Регистратор,	ВыручкаОбороты.АналитикаУчетаПоПартнерам.Партнер,	НАЧАЛОПЕРИОДА(ВыручкаОбороты.Период, МЕСЯЦ),	0,	СУММА(ВыручкаОбороты.СуммаВыручкиСНДСРеглОборот),	NULLИЗ	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(, , Регистратор, ) КАК ВыручкаОборотыСГРУППИРОВАТЬ ПО	ВыручкаОбороты.Регистратор,	ВыручкаОбороты.АналитикаУчетаПоПартнерам.Партнер,	НАЧАЛОПЕРИОДА(ВыручкаОбороты.Период, МЕСЯЦ);////////////////////////////////////////////////////////////////////////////////ВЫБРАТЬ	ВТПродажи.РегистраторЗаказа КАК РегистраторЗаказа,	ВТПродажи.РегистраторВыручки КАК РегистраторВыручки,	ВТПродажи.Партнер КАК Партнер,	ВТПродажи.ПериодМесяц КАК ПериодМесяц,	ВЫРАЗИТЬ(ВТПродажи.СуммаЗаказа * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК ЧИСЛО(15, 2)) КАК СуммаЗаказа,	ВТПродажи.СуммаВыручки КАК СуммаВыручки,	Партнеры.ОсновнойМенеджер КАК ОсновнойМенеджерИЗ	ВТПродажи КАК ВТПродажи		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры		ПО ВТПродажи.Партнер = Партнеры.Ссылка		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;КонецПериода, ) КАК КурсыВалют		ПО ВТПродажи.Валюта = КурсыВалют.Валюта</query>
